generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Legacy table from before Firebase Authentication: password accounts and
// marketing subscribers. No application code reads or writes it any more; it
// is kept (including passwordHash) until a separate decision on removal.
// See docs/auth-and-profiles.md, "Legacy data".
enum UserStatus {
  subscribed
  registered
}

model User {
  id                      String     @id @default(uuid())
  name                    String?
  email                   String     @unique
  passwordHash            String?
  status                  UserStatus
  marketingConsent        Boolean    @default(false)
  emailVerified           Boolean    @default(false)
  emailVerificationSentAt DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
}

enum UserRole {
  client
  admin
}

// Our user: a stable own id (future bookings reference it), linked to exactly
// one Firebase identity. Identity fields (email, emailVerified, isAnonymous,
// signInProvider) are copied only from verified Firebase ID tokens; role only
// by the owner-run assign-role command; name and phone by the user.
model UserProfile {
  id               String   @id @default(uuid()) @db.Uuid
  firebaseUid      String   @unique
  role             UserRole @default(client)
  name             String?
  email            String?
  emailVerified    Boolean  @default(false)
  isAnonymous      Boolean
  signInProvider   String
  // E.164, not verified (no SMS); never used for sign-in or recovery.
  phoneE164        String?
  // `iat` of the newest ID token applied; older tokens never overwrite newer data.
  identityIssuedAt DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings Booking[]
}

enum MarketingConsentSource {
  // Optional, unticked-by-default checkbox at sign-up (POST /api/me/sync).
  signup_checkbox
  // Public subscription form (guests too).
  subscription_form
  // Explicit request from a signed-in user, e.g. re-subscribing after unsubscribing.
  account_request
}

// Marketing consent per email address: the single source of truth. Separate
// from accounts, so a guest's subscription survives losing the anonymous
// session; profiles show it for their verified email. Consent exists only
// after the emailed link is confirmed (double opt-in); Firebase email
// verification is never treated as marketing consent.
model MarketingSubscription {
  id                      String                  @id @default(uuid()) @db.Uuid
  email                   String                  @unique
  // Authoritative status: false by default, true only after confirmation,
  // false again after unsubscribing.
  subscribed              Boolean                 @default(false)
  // The confirmed consent (kept after unsubscribing as history of the last consent).
  consentGivenAt          DateTime?
  consentSource           MarketingConsentSource?
  consentTextVersion      String?
  unsubscribedAt          DateTime?
  // The outstanding confirmation request, if any: its single-use nonce and
  // what the user agreed to when asking.
  confirmationNonce       String?
  confirmationSentAt      DateTime?
  confirmationSource      MarketingConsentSource?
  confirmationTextVersion String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

// ---------------------------------------------------------------------------
// Catalogue, schedule and bookings: one masseuse, one studio (Europe/Paris).
// Instants are timestamptz (absolute time); weekly rules and exceptions are
// local wall-clock values interpreted in the studio time zone.
// See docs/booking.md.
// ---------------------------------------------------------------------------

// A bookable service. Money in integer euro cents (EUR only), duration in
// whole minutes. Archived services stay for the history of bookings but
// cannot be booked any more.
model Service {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  currency        String    @default("EUR")
  archivedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  bookings Booking[]
}

// Recurring weekly working interval in local time: minutes since local
// midnight, [startMinute, endMinute). weekday: ISO, 1 = Monday … 7 = Sunday.
model WeeklyScheduleInterval {
  id          String @id @default(uuid()) @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int

  @@index([weekday])
}

// Replaces the weekly schedule for one local date. No intervals = day off.
model ScheduleException {
  date      DateTime @id @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  intervals ScheduleExceptionInterval[]
}

model ScheduleExceptionInterval {
  id          String            @id @default(uuid()) @db.Uuid
  date        DateTime          @db.Date
  exception   ScheduleException @relation(fields: [date], references: [date], onDelete: Cascade)
  startMinute Int
  endMinute   Int

  @@index([date])
}

enum BookingStatus {
  confirmed
  cancelled
}

enum BookingActor {
  client
  admin
}

// A booking with a snapshot of the service at creation (name, duration,
// price): catalogue edits never change existing bookings, and rescheduling
// keeps them. [startsAt, blockedUntil) is the occupied time including the one
// 15-minute break after the session (blockedUntil = endsAt + 15 min); a
// database exclusion constraint forbids two confirmed bookings from
// overlapping there, so consecutive sessions are at least 15 minutes apart.
model Booking {
  id                   String        @id @default(uuid()) @db.Uuid
  clientProfileId      String        @db.Uuid
  client               UserProfile   @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  serviceId            String        @db.Uuid
  service              Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceName          String
  durationMinutes      Int
  priceCents           Int
  currency             String
  startsAt             DateTime      @db.Timestamptz(3)
  endsAt               DateTime      @db.Timestamptz(3)
  blockedUntil         DateTime      @db.Timestamptz(3)
  status               BookingStatus @default(confirmed)
  // Client-chosen Idempotency-Key of the creating request and what it asked for.
  idempotencyKey       String
  requestFingerprint   String
  cancelledAt          DateTime?     @db.Timestamptz(3)
  cancelledBy          BookingActor?
  cancelledByProfileId String?       @db.Uuid
  cancellationReason   String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  timeChanges BookingTimeChange[]

  @@unique([clientProfileId, idempotencyKey])
  @@index([startsAt])
  @@index([clientProfileId, startsAt])
}

// History of rescheduling: one row per change of time.
model BookingTimeChange {
  id                 String   @id @default(uuid()) @db.Uuid
  bookingId          String   @db.Uuid
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  previousStartsAt   DateTime @db.Timestamptz(3)
  previousEndsAt     DateTime @db.Timestamptz(3)
  newStartsAt        DateTime @db.Timestamptz(3)
  newEndsAt          DateTime @db.Timestamptz(3)
  changedByProfileId String   @db.Uuid
  changedAt          DateTime @db.Timestamptz(3)

  @@index([bookingId, changedAt])
}

// Transactional outbox: events written in the same transaction as the
// booking change, for a future Notifications component. Nothing reads or
// delivers them yet (publishedAt stays null): no email is sent in this stage.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  // Commit order of events (writers hold the calendar lock): consumers read by position.
  position      BigInt    @unique @default(autoincrement())
  type          String
  schemaVersion Int
  aggregateType String
  aggregateId   String    @db.Uuid
  // One event per business fact, e.g. "booking.created:<bookingId>".
  dedupeKey     String    @unique
  payload       Json
  occurredAt    DateTime  @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)

  @@index([publishedAt, position])
  @@index([aggregateId])
}
