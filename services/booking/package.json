{
  "name": "@massage/booking",
  "version": "1.0.0",
  "private": true,
  "description": "Booking service: profiles, catalogue, schedule, availability and bookings; marketing subscription",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=${DOTENV_CONFIG_PATH:-../../.env} src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "prisma": "DOTENV_CONFIG_PATH=${DOTENV_CONFIG_PATH:-../../.env} prisma",
    "migrate:deploy": "tsx --env-file-if-exists=${DOTENV_CONFIG_PATH:-../../.env} src/migrate/run-migrations.ts",
    "emulator:auth": "npx --yes firebase-tools@15.34.1 emulators:start --only auth --project demo-massage-it --config test/integration/firebase.json"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "14.5.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "1.13.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.1",
    "supertest": "7.3.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
