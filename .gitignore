# Шаблони без "/" на початку діють на будь-якій глибині,
# тобто й для services/*/ (node_modules, dist, .env).
node_modules/
dist/
*.tsbuildinfo
# Prisma Client (generator output inside each service)
services/*/src/generated/
.env
.env.*
!.env.example
.DS_Store

# локальні/AI/IDE 
.agents/
.claude/
.windsurf/
.neon
skills-lock.json
# Terraform: provider cache, state, saved plans, local values.
# Kept in Git: *.tf, .terraform.lock.hcl and *.example files.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
*.tfbackend
crash.log
crash.*.log

# Firebase emulator (firebase-tools) debug logs
firebase-debug.log
firebase-debug.*.log

# Local Firebase test client: web config of the environment being checked
tools/firebase-check/firebase-config.local.json
