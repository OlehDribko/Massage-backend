generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  subscribed
  registered
}

model User {
  id               String     @id @default(uuid())
  name             String?
  email            String     @unique
  passwordHash     String?
  status           UserStatus
  marketingConsent Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}