# Приклад конфігурації services/booking (без секретів).
# Для локальної розробки скопіюйте в .env у корені репозиторію; `npm run dev`
# підхоплює його автоматично. Production читає лише змінні середовища процесу.

# --- Загальні ---
# development | test | production (default: production)
NODE_ENV=development
# 1-65535 (default: 3001)
PORT=3001
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
# Обов'язково: postgres:// або postgresql:// URL runtime-ролі застосунку (лише DML).
# Credentials percent-encoded. Дозволені параметри: sslmode (не слабший за DATABASE_SSL_MODE),
# channel_binding=prefer|disable. Інші параметри та channel_binding=require — помилка запуску.
DATABASE_URL=
# verify-full (default): TLS з перевіркою сертифіката й імені хоста.
# disable: без TLS — лише для локальної БД.
DATABASE_SSL_MODE=verify-full
# Розмір пулу з'єднань (1-50, default: 5) і таймаут встановлення з'єднання, мс (default: 5000)
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
# Клієнтський таймаут pg для запитів застосунку (Prisma), мс (default: 30000)
DATABASE_QUERY_TIMEOUT_MS=30000
# Лише для ланцюжка міграцій `npm run migrate:deploy` (роль migrator). Застосунок її не читає.
# Без неї міграції завершуються помилкою — fallback немає.
MIGRATION_DATABASE_URL=
# TLS для з'єднання раннера міграцій: verify-full (default) або disable (лише локально)
MIGRATION_DATABASE_SSL_MODE=verify-full
# Runtime-роль, якій раннер видає DML на бізнес-таблиці (має існувати)
BOOKING_RUNTIME_ROLE=booking_app
# Необов'язково: версія збірки, повертається в /health/ready ([A-Za-z0-9._+-], до 64 символів)
APP_VERSION=
# Необов'язково: дозволений CORS origin (http/https URL). Без нього CORS-заголовки не додаються.
FRONTEND_URL=
# Граничний час graceful shutdown, мс (default: 10000)
SHUTDOWN_TIMEOUT_MS=10000
# Граничний час перевірки БД у /health/ready, мс (default: 2000)
READINESS_TIMEOUT_MS=2000

# --- Firebase Authentication (/api/me). Див. docs/auth-and-profiles.md ---
# Без FIREBASE_PROJECT_ID маршрутів /api/me немає. Функціональні деплої задають
# REQUIRE_FIREBASE_AUTH=true: тоді запуск без Firebase — помилка конфігурації.
REQUIRE_FIREBASE_AUTH=false
# Локально з емулятором (npm run emulator:auth -w @massage/booking):
#   FIREBASE_PROJECT_ID=demo-massage-it, FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099,
#   NODE_ENV=development. Емулятор заборонений при NODE_ENV=production.
FIREBASE_PROJECT_ID=
# service-account-json | application-default | none (лише з емулятором)
FIREBASE_CREDENTIALS=
# Секрет: вміст JSON-ключа службового акаунта (при service-account-json). Не комітити.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_EMULATOR_HOST=

# --- Маркетингова підписка (/api/marketing, листи через Brevo) ---
# Лише "true" або "false" (default: false). Інші значення — помилка запуску.
ENABLE_MARKETING_SUBSCRIPTION=false
# Обов'язкові лише при ENABLE_MARKETING_SUBSCRIPTION=true (разом із FRONTEND_URL):
BREVO_API_KEY=
EMAIL_FROM_NAME=
EMAIL_FROM_EMAIL=
# Щонайменше 32 символи
ACTION_TOKEN_SECRET=
